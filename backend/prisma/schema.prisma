generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      String    @default("user")   // user, admin, technician
  status    String    @default("active") // active, blocked
  requests         Request[]  @relation("RequestOwner")
  assignedRequests Request[]  @relation("RequestTechnician")
  serviceSkills    Service[]  @relation("TechnicianServices")
  comments         Comment[]
  createdAt        DateTime   @default(now())
}

model Service {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  icon        String
  status      String    @default("active")
  requests    Request[]
  technicians User[]    @relation("TechnicianServices")
}

model Request {
  id          Int       @id @default(autoincrement())
  title       String
  description String    @db.Text
  priority    String    // Low, Medium, High, Critical
  status      String    @default("Pending") // Pending, In Progress, Awaiting Admin Approval, Completed, Rejected
  attachment  String?
  user         User      @relation("RequestOwner", fields: [userId], references: [id])
  userId       Int
  technician   User?     @relation("RequestTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  technicianId Int?
  service      Service   @relation(fields: [serviceId], references: [id])
  serviceId    Int
  comments     Comment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Comment {
  id        Int      @id @default(autoincrement())
  comment   String   @db.Text
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
}
